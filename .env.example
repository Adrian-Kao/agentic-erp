ERP_IMPORT_DATABASE_URL=mysql+pymysql://erp_importer:CHANGE_ME@localhost:3306/erp_demo?charset=utf8mb4
MYSQL_ROOT_PASSWORD=CHANGE_ME
ERP_APP_PASSWORD=CHANGE_ME
ERP_READ_PASSWORD=CHANGE_ME
ERP_IMPORTER_PASSWORD=CHANGE_ME
